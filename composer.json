{
    "name": "haimaz/business-stepper",
    "description": "A laravel package for business systems to manage ordering Services, Products, Subscriptions based dynamic steps and inputs to excute them based user data",
    "license": "MIT",
    "authors": [
        {
            "name": "Haitham Maznai",
            "email": "haitham.almaznai7@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "haimaz\\BusinessSteper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "haimaz\\BusinessSteper\\Tests\\": "tests/"
        }
    },
    "require": {
        "erusev/parsedown": "^1.7",
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "orchestra/testbench": "^10.6"
    },
    "extra": {
        "laravel": {
            "providers": [
                "haimaz\\BusinessSteper\\BusinessSteperProvider"
            ]
        }
    }
}
